#!/usr/bin/env bash

set -Eeuo pipefail

readonly original_command="${SSH_ORIGINAL_COMMAND:-}"

if [[ ! "$original_command" =~ ^deploy\ [0-9a-f]{40}$ ]]; then
    printf 'This key is restricted to Service Portal production deployments.\n' >&2
    exit 126
fi

readonly release_sha="${original_command#deploy }"
exec sudo -n -- /usr/local/sbin/deploy-service-portal "$release_sha"
